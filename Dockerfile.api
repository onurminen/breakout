FROM node:24-alpine AS ui-build
WORKDIR /src/ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci
COPY ui/ ./
RUN npm run build

FROM golang:1.27 AS api-build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /service ./cmd/api

FROM gcr.io/distroless/static-debian12
COPY --from=api-build /service /service
COPY --from=ui-build /src/ui/dist /ui
ENTRYPOINT ["/service"]
